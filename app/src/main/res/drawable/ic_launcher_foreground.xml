<?xml version="1.0" encoding="utf-8"?>
<!--
    Bridge launcher glyph: a minimal bridge arch drawn as an interrupted
    stroke. The arc stops, leaves a gap, and picks up exactly where it
    stopped (lighter mint) - work that survives interruption and resumes.
    All geometry stays inside the adaptive-icon safe zone (middle ~60%).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deck line (Mint300, app accent) -->
    <path
        android:pathData="M28,72 L80,72"
        android:strokeColor="#4DD8C4"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Arch, first span: 180deg to 105deg of a circle r=24 centered at (54,65) -->
    <path
        android:pathData="M30,65 A24,24 0 0 1 47.79,41.82"
        android:strokeColor="#4DD8C4"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- Arch, resumed span after the gap: 68deg to 0deg (Mint200 highlight) -->
    <path
        android:pathData="M62.99,42.75 A24,24 0 0 1 78,65"
        android:strokeColor="#7BEFD8"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
