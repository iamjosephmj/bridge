<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required by JobPlanCompiler: every host job class sets a network-type constraint
         (setRequiredNetworkType), and JobScheduler.enqueue/schedule throws SecurityException
         at the binder layer without this permission. Found via the real-device instrumented
         smoke test (Task 13) — jobs were silently never created on API 36 without it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <service
            android:name="io.github.iamjosephmj.bridge.dispatch.BridgeJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- L4 deadline-escalation alarm tier (setAndAllowWhileIdle → reconcile). -->
        <receiver android:name="io.github.iamjosephmj.bridge.dispatch.BridgeAlarmReceiver"
            android:exported="false" />

        <!-- adb diagnostics entry point; see ReportReceiver kdoc for the exported rationale. -->
        <receiver android:name="io.github.iamjosephmj.bridge.diagnostics.ReportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.iamjosephmj.bridge.REPORT" />
            </intent-filter>
        </receiver>

        <receiver android:name="io.github.iamjosephmj.bridge.dispatch.BridgeRescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
